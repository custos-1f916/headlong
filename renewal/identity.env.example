# Identity defaults, not a secret file or an external admission-policy override.
# Install for HOME=/root, app=/root/.headlong/app, identity=custos.
PATH=/root/.local/bin:/root/.bun/bin:/usr/local/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/emulator:/opt/android-sdk/cmdline-tools/latest/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ANDROID_HOME=/opt/android-sdk
GODOT_BIN=/usr/local/bin/godot
VOIDLE_AVD=Voidle_Test_x86
VOIDLE_SYSTEM_IMAGE='system-images;android-34;google_apis;x86_64'
VOIDLE_PROJECT_DIR=/opt/custos/work/voidle
LLM_PROVIDER=openai-compatible
LLM_API_URL=http://192.168.86.44:18080/v1/chat/completions
SHELLM_API_URL=http://192.168.86.44:18080/v1/chat/completions

# Every native completion path uses the same admitted model; no provider fallback.
LLM_MODEL=qwen3.8-27b
SHELLM_MODEL=qwen3.8-27b
SHELLM_FAST_MODEL=qwen3.8-27b
SHELLM_SUMMARY_MODEL=qwen3.8-27b
THINK_MODEL=qwen3.8-27b
MONOLITH_REPLY_MODEL=qwen3.8-27b
RESPONDER_NOTES_MODEL=qwen3.8-27b
ROLLUP_MODEL=qwen3.8-27b
RECAP_MODEL=qwen3.8-27b
RECAP_MAP_MODEL=qwen3.8-27b
RECAP_REDUCE_MODEL=qwen3.8-27b
SHELLM_EFFORT=xhigh
LLM_EFFORT=xhigh

# Bounded substantive wake, with room for Qwen reasoning and executable output.
SHELLM_MAX_ITERATIONS=512
SHELLM_MAX_TOKENS=65536
LLM_MAX_TOKENS=65536
# Finish the wire response instead of canceling at the first Bash block.
# Early client cancellation discards incomplete model output.
SHELLM_STOP_AFTER_CODE_BLOCK=0
LLM_STOP_AFTER_CODE_BLOCK=0
SHELLM_RUN_SUMMARY=0
LLM_CONNECT_TIMEOUT=10
LLM_MAX_TIME=630
LLM_RETRIES=0
# A busy/stop denial is deferred, not an invitation to retry or bypass.

# Reserve space for system instructions/provider framing inside the 128KiB gateway.
# Native context budgets historical fields; pinned instructions remain whole.
MODEL_CONTEXT_WINDOW=204800
MONOLITH_CONTEXT_BUDGET=4000
RECAP_CONTEXT_BUDGET_MAX=4000
RECAP_ROLLUP_MAX_TOKENS=65536
MONOLITH_TIERED_MEMORY=1
SHELLM_CONTEXT_SCOPE=run
SHELLM_CONTEXT_MAX_BYTES=98304
SHELLM_CONTEXT_RUN_TAIL=50
SHELLM_CONTEXT_RUN_TAIL_BLOCK=10
SHELLM_CONTEXT_BLOCK_LIMIT=4096
SHELLM_CONTEXT_WHOLE_BLOCKS=1

# Continuous pacing remains subject to backend concurrency and operator pause; there is no usage quota.
MONOLITH_BACKOFF_BASE=5
MONOLITH_BACKOFF_FACTOR=2
MONOLITH_BACKOFF_CAP=300
MONOLITH_BACKOFF_HOLD=3
MONOLITH_THOUGHT_CAP=300

# No asynchronous personality-note completion side channel.
RESPONDER_PERSON_NOTES=0
RESPONDER_PERSON_NOTES_SYNC=1

# xhigh utility calls need reasoning budget even when their visible answer is short.
LLM_MIN_OUTPUT_TOKENS=65536
MEM_SEARCH_MAX_TOKENS=65536
MEM_SEARCH_MAX_BYTES=65536
