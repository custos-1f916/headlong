#!/usr/bin/env python3
"""mealplan — Custos's CLI for the kitchen service (recipes, sales, weekly plans, list, cart).

  mealplan brief                         planning brief: candidates with sale matches, top sales, prefs, recent plans
  mealplan sales [--refresh]             this week's Whole Foods deals for the family's store
  mealplan recipes [--q text] [--book B] one line per recipe
  mealplan recipe SLUG                   ingredients + steps
  mealplan plan show [--week YYYY-Www]   the week's plan (default: the week of the next Saturday pickup)
  mealplan plan set --week W --dinner DATE=SLUG ... [--note text]
  mealplan plan proposed                 record that the week's first message went out
  mealplan plan engaged                  record that Hal or Dani replied about the plan
  mealplan plan skip [--note text]       they declined this week: no reminder, no cart (plan resume undoes it)
  mealplan plan finalize [--week W]      writes dinners into the catalog's meal planner
  mealplan list build [--week W]         ingredients -> grocery lines (pantry set aside) + standing staples + this week's extras
  mealplan list preview [--week W]       print the current list
  mealplan list add "item" [--note why]  one-off for this week ("grab butter") — survives rebuilds; "2 lemons" sets a count
  mealplan list remove "item"            drop a one-off
  mealplan list have "item" [--note why] they already have it ("I have gnocchi"): stays on the list as [have], never bought
  mealplan list unhave "item"            undo that
  mealplan books                         every scanned cookbook: recipes imported, page flags, reviewed or not
  mealplan book flags "Title"            the digitizer's flagged pages with their transcripts (judge them, no vision needed)
  mealplan book reviewed "Title" --note "one paragraph about the book: character, weeknight picks, what to ask Hal/Dani"
  mealplan study [--n 10]                recipes nobody has studied yet (for a curiosity turn)
  mealplan studied SLUG --note "…"       record what you learned about a recipe (fit, constraints, who might like it)
  mealplan prefs                         constraints, rules, questions, likes/dislikes/brands (the family's knobs)
  mealplan learn KIND "text" [--remove]  KIND: likes | dislikes | brands | pantry | staples | rules | questions
                                         (pantry = assumed on hand, skipped from lists; staples = bought EVERY week, with a count: "4 apples")
  mealplan product "item" ASIN [--qty N] pin the product the family wants for a list item (auto-chosen every week); --remove unpins
  mealplan constraint KEY VALUE          dinners_per_week weeknight_max_minutes servings leftover_dinners no_repeat_weeks sale_picks_per_week budget_cap_usd pickup_day
  mealplan cooked SLUG [--date D] [--note text]
  mealplan search "text"                 Whole Foods products for a phrase (brand, size, bought-before flag)
  mealplan cart status                   is the Whole Foods session alive, and whose? (Dani's account since 2026-09-10)
  mealplan cart login                    make a fresh phone sign-in link (text it to Hal or Dani only; 15 min)
  mealplan cart refresh                  try to renew the session silently first (no one has to type)
  mealplan cart logout                   drop the session AND the browser profile (only when switching accounts)
  mealplan cart candidates [--week W]    top products per unmatched list line
  mealplan cart choose "item" ASIN [--qty N]
  mealplan cart fill [--week W] [--force]  add every chosen line to the Whole Foods cart — never checks out; refuses a second fill unless --force
                                         (fill / plan proposed / plan finalize also refuse while family messages newer than the plan are unread: record them, then --read)
  mealplan cart show [--week W]          the plan's lines + what the site says is in the cart
  mealplan cart diff [--week W] [--snapshot]  what Hal and Dani changed in the cart after the fill (removed/added/counts) — ask, then learn
  mealplan cart set ASIN --qty N         change a cart line's quantity (0 removes it)
  mealplan history [--products] [--sync] past orders on the account (--sync pulls them fresh; --products = what recurs = the real staples)
  (checkout stays with Hal: he places the order in the Amazon app — Tier 1)

Config: /etc/kitchen.env with KITCHEN_URL and KITCHEN_TOKEN (Hal installs it).
"""
import argparse, json, os, re, subprocess, sys, urllib.parse, urllib.request
from datetime import date, timedelta

GROUP = os.environ.get("MEALPLAN_GROUP", "Collette Haus")


def unread_family_messages(plan):
    """Signal messages from Hal or Dani (the family group or a DM) that arrived after the plan
    was last recorded. Only works inside Custos's guest (needs the activated identity: ROOT_TRAJ_ID
    and `traj` on PATH); elsewhere it returns nothing. 2026-09-10: the cart was filled from a plan
    that predated "I already have gnocchi" — `cart fill`, `plan proposed` and `plan finalize` now
    refuse while such messages are unread, until the run records them and passes --read."""
    root = os.environ.get("ROOT_TRAJ_ID")
    if not root:
        return []
    try:
        path = subprocess.check_output(["traj", "path", root], stderr=subprocess.DEVNULL, timeout=20).decode().strip()
    except Exception:  # noqa: BLE001 - no trajectory, no guard
        return []
    idx = os.path.join(os.path.dirname(path), "messages.jsonl")
    marks = [h.get("at") or "" for h in plan.get("history") or []] + [plan.get("proposed_at") or "", plan.get("engaged_at") or ""]
    last = max(marks)[:16] if any(marks) else ""  # plan stamps are UTC-naive minutes (kitchen box runs UTC); trajectory ts are UTC ISO
    if not last or not os.path.exists(idx):
        return []
    out = []
    try:
        for line in open(idx, encoding="utf-8", errors="replace"):
            try:
                m = json.loads(line)
            except ValueError:
                continue
            c = m.get("content") or ""
            if not str(m.get("from", "")).startswith("signal") or m.get("ts", "")[:16] <= last:
                continue
            spk = re.search(r'"speaker":"([^"]+)"', c); grp = re.search(r'"group":"([^"]+)"', c)
            if not ((grp and grp.group(1) == GROUP) or (spk and spk.group(1) in ("Hal", "Dani") and '"scope":"direct"' in c)):
                continue
            body = c.split("Message:\n", 1)[-1].split("\nParticipation:", 1)[0].strip()
            out.append((m["ts"][:16] + "Z", spk.group(1) if spk else "?", body[:400].replace("\n", " | ")))
    except OSError:
        return []
    return out


def require_read(plan, action, ok):
    """Refuse `action` while family messages newer than the plan are unread (unless --read)."""
    if ok:
        return
    new = unread_family_messages(plan)
    if not new:
        return
    print(f"NOT doing `{action}`: {len(new)} message(s) from the family arrived after the plan was last recorded. Read them, record what they ask "
          f"(`mealplan list have` / `plan set` / `learn pantry` / `list add`), then retry with --read:")
    for ts, spk, body in new:
        print(f"  {ts} {spk}: {body}")
    sys.exit(3)


def cfg():
    c = {"KITCHEN_URL": "http://192.168.86.63:8090", "KITCHEN_TOKEN": ""}
    for path in ("/etc/kitchen.env", os.path.expanduser("~/.kitchen.env")):
        try:
            for line in open(path):
                m = re.match(r"^\s*(KITCHEN_URL|KITCHEN_TOKEN)\s*=\s*(.*?)\s*$", line)
                if m:
                    c[m.group(1)] = m.group(2).strip('"')
        except OSError:
            pass
    c.update({k: v for k, v in os.environ.items() if k in c})
    return c


def call(method, path, body=None, params=None):
    c = cfg()
    url = c["KITCHEN_URL"].rstrip("/") + path + ("?" + urllib.parse.urlencode({k: v for k, v in (params or {}).items() if v}) if params else "")
    req = urllib.request.Request(url, data=json.dumps(body).encode() if body is not None else None, method=method,
                                 headers={"Authorization": "Bearer " + c["KITCHEN_TOKEN"], "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=180) as r:
            return json.loads(r.read() or b"null")
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")[:400]
        sys.exit(f"kitchen service said {e.code}: {detail}")
    except urllib.error.URLError as e:
        sys.exit(f"kitchen service unreachable ({e.reason}); say so in the goal, do not improvise")


def next_week():
    """The week being planned: the ISO week of the next Saturday pickup strictly after today."""
    d = date.today(); d = d + timedelta(days=((5 - d.weekday()) % 7) or 7); y, w, _ = d.isocalendar(); return f"{y}-W{w:02d}"


def show_prefs(p):
    print("constraints:", ", ".join(f"{k}={v}" for k, v in p.get("constraints", {}).items()))
    for k in ("rules", "questions", "likes", "dislikes", "brands"):
        if p.get(k):
            print(f"{k}:"); [print("  - " + x) for x in p[k]]
    print("staples (bought every week): " + (", ".join(p.get("staples", [])) or "(none)") + "  (`mealplan learn staples \"4 apples\"` / --remove)")
    if p.get("products"):
        print("pinned products: " + "; ".join(f"{k} -> {v.get('name') or v.get('asin')}" for k, v in p["products"].items()) + "  (`mealplan product \"item\" ASIN`)")
    print(f"pantry: {p.get('pantry_count', len(p.get('pantry', [])))} items assumed on hand + dried spices/seeds/oils by rule, skipped from lists (`mealplan learn pantry \"item\"` / --remove)")


def show_plan(p):
    print(f"week {p['week']} (pickup {p['pickup']}) status={p['status']} proposed={p.get('proposed_at') or '-'} engaged={p.get('engaged_at') or '-'}")
    for d in p.get("dinners", []):
        print(f"  {d.get('date') or '????-??-??'}  {d['title']}  [{d['slug']}]  {d.get('url') or ''}" + (f"  — {d['note']}" if d.get("note") else ""))
    for n in p.get("notes", [])[-3:]:
        print(f"  note {n['at']}: {n['text']}")
    if p.get("list"):
        print(f"  list: {len(p['list'])} lines, {sum(1 for x in p['list'] if x.get('status') == 'unmatched')} unmatched, pantry assumed: {len(p.get('pantry_assumed', []))}")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cmd"); ap.add_argument("sub", nargs="?"); ap.add_argument("arg", nargs="?")
    ap.add_argument("--week"); ap.add_argument("--q"); ap.add_argument("--book"); ap.add_argument("--refresh", action="store_true")
    ap.add_argument("--dinner", action="append", default=[], metavar="DATE=SLUG"); ap.add_argument("--note"); ap.add_argument("--date"); ap.add_argument("--json", action="store_true"); ap.add_argument("--remove", action="store_true"); ap.add_argument("asin", nargs="?"); ap.add_argument("--qty", type=int); ap.add_argument("--force", action="store_true"); ap.add_argument("--snapshot", action="store_true"); ap.add_argument("--products", action="store_true"); ap.add_argument("--sync", action="store_true"); ap.add_argument("--read", action="store_true", help="I have read and recorded every family message since the plan was last touched"); ap.add_argument("--n", type=int, default=10)
    a = ap.parse_args()
    wk = a.week or next_week()
    if a.cmd == "brief":
        b = call("GET", "/brief")
        if a.json:
            print(json.dumps(b, indent=1)); return
        pl = b.get("plan") or {}
        print(f"brief {b['generated']}: catalog {b['catalog_size']} recipes; planning {b['next_week']} (pickup {b['week_pickup']}, status={pl.get('status') or 'draft'}, proposed={pl.get('proposed_at') or '-'}, engaged={pl.get('engaged_at') or '-'}, {len(pl.get('dinners') or [])} dinners drafted); sales at {b['sales']['store']} valid to {b['sales']['valid']} ({b['sales']['count']} deals)")
        print("cookbooks:", "; ".join(f"{b['book']} ({b['recipes']} recipes, {b['flags']} flags{'' if b['reviewed'] else ', NOT reviewed'})" for b in b.get("books", [])) or "(none scanned yet)", f"| {b.get('unstudied_recipes', 0)} recipes not yet studied")
        print("candidates (score: sale matches, rating, not recent):")
        for c in b["candidates"]:
            flags = (" ON SALE: " + ", ".join(c["on_sale"]) if c["on_sale"] else "") + (" (recent)" if c["recent"] else "")
            print(f"  - {c['title']} [{c['slug']}] {c['book'] or ''} {c['yield'] or ''} {c['time'] or ''} rating={c['rating'] or '-'}{flags}\n    {c.get('url') or ''}")
        print("top sales:"); [print("  - " + s) for s in b["sales"]["top"]]
        show_prefs(b["prefs"])
        print("recent plans:"); [print(f"  {r['week']}: {', '.join(r['dinners']) or '(none)'}") for r in b["recent_plans"]]
    elif a.cmd == "sales":
        s = call("GET", "/sales", params={"refresh": "1" if a.refresh else ""})
        print(f"{s.get('store_name')} (store {s.get('store_id')}) fetched {s.get('fetched')}: {s.get('count')} deals")
        for d in s.get("deals", []):
            b = f"{d['brand']} " if d.get("brand") else ""
            print(f"  - {b}{d['name']}: {d.get('prime_price') or d.get('sale_price')}" + (f" (reg {d['regular_price']})" if d.get("regular_price") else "") + (f" valid {d['valid_from']}-{d['valid_to']}" if d.get("valid_from") else ""))
    elif a.cmd == "recipes":
        for r in call("GET", "/recipes", params={"q": a.q, "book": a.book}):
            print(f"  - {r['title']} [{r['slug']}] {r['book'] or ''} {r['yield'] or ''} {r['total_time'] or ''} rating={r['rating'] or '-'} last={r['last_made'] or '-'}")
    elif a.cmd == "recipe":
        r = call("GET", "/recipes/" + urllib.parse.quote(a.sub or ""))
        print(f"{r['title']} — {r['book'] or ''} {r['yield'] or ''} {r['total_time'] or ''}\n{r.get('description') or ''}\ningredients:")
        [print("  - " + i) for i in r["ingredients"]]
        print("steps:"); [print(f"  {n}. {s}") for n, s in enumerate(r["steps"], 1)]
    elif a.cmd == "plan":
        if a.sub == "show":
            show_plan(call("GET", f"/plans/{wk}"))
        elif a.sub == "set":
            dinners = []
            for spec in a.dinner:
                d, s = spec.split("=", 1); dinners.append({"date": d, "slug": s})
            body = {"dinners": dinners} if dinners else {}
            if a.note:
                body["note"] = a.note
            show_plan(call("POST", f"/plans/{wk}", body))
        elif a.sub in ("proposed", "engaged", "skip", "resume"):
            if a.sub == "proposed":
                require_read(call("GET", f"/plans/{wk}"), "plan proposed", a.read)
            body = {a.sub: True}
            if a.note:
                body["note"] = a.note
            show_plan(call("POST", f"/plans/{wk}", body))
        elif a.sub == "finalize":
            require_read(call("GET", f"/plans/{wk}"), "plan finalize", a.read)
            show_plan(call("POST", f"/plans/{wk}/finalize", {}))
        else:
            sys.exit("plan show|set|proposed|engaged|skip|resume|finalize")
    elif a.cmd == "list":
        if a.sub in ("add", "remove"):
            p = call("POST", f"/plans/{wk}/extras", {"item": a.arg, "note": a.note, "remove": a.sub == "remove"})
        elif a.sub in ("have", "unhave"):
            p = call("POST", f"/plans/{wk}/have", {"item": a.arg, "note": a.note, "remove": a.sub == "unhave"})
        else:
            p = call("POST", f"/plans/{wk}/list", {}) if a.sub == "build" else call("GET", f"/plans/{wk}")
        show_plan(p)
        for x in p.get("list", []):
            print(f"  [{x.get('status', '?'):9s}] {x['item']}  ({x['need']})  for {', '.join(x['for'])}" + (f"  <{x['source']}>" if x.get('source') in ('staple', 'extra') else "") + (f"  x{x['quantity']}" if x.get('quantity') else "") + (" (pinned)" if x.get('pinned') else ""))
        if p.get("have"):
            print("  they already have:", "; ".join(x["item"] + (f" ({x['note']})" if x.get("note") else "") for x in p["have"]))
        if p.get("extras"):
            print("  this week's extras:", "; ".join(x["item"] + (f" ({x['note']})" if x.get("note") else "") for x in p["extras"]))
        if p.get("pantry_assumed"):
            print("  pantry assumed:", "; ".join(p["pantry_assumed"]))
    elif a.cmd == "books":
        for b in call("GET", "/books"):
            rv = b.get("reviewed"); print(f"  - {b['book']}: {b['recipes_imported']} recipes imported ({b['recipes_extracted']} extracted from {b['pages']} pages), {b['flags']} flag(s), last import {b['last_import'] or '-'}" + (f"; reviewed {rv['at']}: {rv['note'][:80]}" if rv else "; NOT reviewed"))
    elif a.cmd == "book":
        if a.sub == "flags":
            r = call("GET", f"/books/{urllib.parse.quote(a.arg or '')}/flags")
            print(f"{r['book']}: {len(r['flags'])} flag(s); imported slugs: {', '.join(list(r['imported'].values())[:12])}")
            for f in r["flags"]:
                print(f"  - page file {f['page_file']} (printed {f['printed_pages']}): {f['why']}; recipes on page: {f['recipes_on_page']}; confidence {f['confidence']}")
                print("    transcript: " + (f["transcript"] or "").replace("\n", " / ")[:600])
        elif a.sub == "reviewed":
            print(json.dumps(call("POST", f"/books/{urllib.parse.quote(a.arg or '')}/reviewed", {"note": a.note or ""})))
        else:
            sys.exit("book flags|reviewed \"Title\"")
    elif a.cmd == "study":
        r = call("GET", "/books/study", params={"n": str(a.n)})
        print(f"{r['unstudied']} recipes not studied yet ({r['studied']} done). Next:")
        for x in r["next"]: print(f"  - {x['title']} [{x['slug']}] {x['book'] or ''} {x['yield'] or ''} {x['time'] or ''}")
    elif a.cmd == "studied":
        print(json.dumps(call("POST", f"/recipes/{urllib.parse.quote(a.sub or '')}/studied", {"note": a.note or ""})))
    elif a.cmd == "prefs":
        show_prefs(call("GET", "/prefs"))
    elif a.cmd == "learn":
        show_prefs(call("POST", "/prefs/learn", {"kind": a.sub, "text": a.arg, "remove": a.remove}))
    elif a.cmd == "product":
        r = call("POST", "/prefs/product", {"item": a.sub, "asin": a.arg, "quantity": a.qty, "remove": a.remove})
        print("pinned products:"); [print(f"  - {k} -> {v.get('asin')} {v.get('name') or ''}" + (f" x{v['quantity']}" if v.get('quantity') else "")) for k, v in r.items()]
    elif a.cmd == "history":
        if a.sync:
            r = call("POST", "/shopper/orders/sync", {}); print(f"synced {r['count']} orders from {r['customer']}'s account at {r['synced_at']}")
        if a.products:
            for x in call("GET", "/shopper/orders", params={"products": "1"}):
                print(f"  - {x['asin']}  {x.get('name') or ''}  in {x['orders']} orders, {x['units']} units")
        else:
            r = call("GET", "/shopper/orders")
            print(f"{r.get('count', 0)} past orders on {r.get('customer') or '?'}'s account (synced {r.get('synced_at') or 'never'})")
            for o in r.get("orders", []):
                print(f"  - {o.get('date') or '?'}  {o.get('status') or ''}  {o.get('program') or ''}  total {o.get('total') or '?'}  {o.get('item_count') or 0} items: " + ", ".join(o.get("items", [])[:12]))
    elif a.cmd == "constraint":
        show_prefs(call("POST", "/prefs/set", {"key": a.sub, "value": a.arg}))
    elif a.cmd == "cooked":
        print(json.dumps(call("POST", "/cooked", {"slug": a.sub, "date": a.date, "note": a.note})))
    elif a.cmd == "search":
        for pr in call("GET", "/shopper/search", params={"q": a.sub or "", "n": "8"}):
            flags = (" BOUGHT-BEFORE" if pr.get("bought_before") else "") + (f" ${pr['price']}" if pr.get("price") else "")
            print(f"  - {pr['asin']}  {pr.get('brand') or ''} | {pr.get('name')}{flags}")
    elif a.cmd == "cart":
        if a.sub == "status":
            s = call("GET", "/shopper/status", params={"force": "1" if a.refresh else ""})
            print(("signed in as " + json.dumps(s.get("customer"))) if s.get("logged_in") else "NOT signed in" + (f" ({s.get('error')})" if s.get("error") else ""),
                  f"| session from {s.get('captured_at')} via {s.get('how')}" if s.get("has_session") else "| no session on file")
            if s.get("login_in_progress"):
                print("  a phone login is in progress:", s["login_in_progress"]["url"], s["login_in_progress"]["phase"])
        elif a.sub == "login":
            r = call("POST", "/shopper/login/start", {})
            print(f"Send Hal this link (valid ~15 min, LAN only): {r['url']}")
        elif a.sub == "refresh":
            r = call("POST", "/shopper/refresh", {})
            print("refreshed" if r.get("refreshed") else "could not refresh silently — use `mealplan cart login`", "| logged_in:", r.get("status", {}).get("logged_in"))
        elif a.sub == "candidates":
            r = call("GET", f"/plans/{wk}/cart/candidates")
            for line in r["lines"]:
                if line.get("chosen"):
                    print(f"  [{line.get('status')}] {line['item']} -> {line['chosen'].get('asin')} {line['chosen'].get('name')}"); continue
                if line.get("error"):
                    print(f"  [error] {line['item']}: {line['error']}"); continue
                print(f"  {line['item']}  (need: {line.get('need')})")
                for pr in line.get("candidates", []):
                    flags = (" BOUGHT-BEFORE" if pr.get("bought_before") else "") + (f" ${pr['price']}" if pr.get("price") else "")
                    print(f"      {pr['asin']}  {pr.get('brand') or ''} | {pr.get('name')}{flags}")
        elif a.sub == "logout":
            print(json.dumps(call("DELETE", "/shopper/session", params={"profile": "1"})))
        elif a.sub == "diff":
            r = call("GET", f"/plans/{wk}/cart/diff", params={"snapshot": "1" if a.snapshot else ""})
            if r.get("error"):
                print("cannot diff:", r["error"]); return
            print(f"filled: {json.dumps(r.get('cart_filled'))} | site cart now: {r['site_items']} items, ${r.get('site_subtotal')}")
            for x in r["removed"]: print(f"  - removed by them: {x['item']} -> {x.get('name') or x['asin']} x{x['quantity']}  <{x.get('source')}>")
            for x in r["added"]: print(f"  + added by them: {x.get('name') or x['asin']} x{x['quantity']} ${x.get('price')}")
            for x in r["quantity_changed"]: print(f"  ~ count changed: {x['item']} {x['planned']} -> {x['now']}")
            if r.get("have"): print("  already have:", "; ".join(h["item"] for h in r["have"]))
            if r.get("unmatched"): print("  unmatched:", ", ".join(r["unmatched"]))
        elif a.sub == "choose":
            line = call("POST", f"/plans/{wk}/cart/choose", {"item": a.arg, "asin": a.asin, "quantity": a.qty})
            print(f"  {line['item']} -> {line['product'].get('asin')} x{line['product'].get('quantity')} {line['product'].get('name') or ''}")
        elif a.sub == "fill":
            require_read(call("GET", f"/plans/{wk}"), "cart fill", a.read)
            r = call("POST", f"/plans/{wk}/cart/fill", {"force": a.force})
            if r.get("error"):
                print("NOT filled:", r["error"])
            print(f"added {len(r.get('added', []))}, failed {len(r.get('failed', []))}, skipped (no choice) {len(r.get('skipped', []))}")
            for x in r.get("added", []): print(f"  + {x['item']} -> {x.get('name') or x['asin']} x{x['quantity']}")
            for x in r.get("failed", []): print(f"  ! {x['item']}: {x['why']}")
            for x in r.get("skipped", []): print(f"  - skipped: {x}")
            print("cart:", json.dumps(r.get("cart"))[:600])
        elif a.sub == "set":
            r = call("POST", "/shopper/cart/set", {"asin": a.arg, "quantity": a.qty})
            print("cart now:", json.dumps(r)[:300])
        elif a.sub == "show":
            r = call("GET", f"/plans/{wk}/cart")
            for l in r["lines"]:
                print(f"  [{l.get('status') or '-':9s}] {l['item']}" + (f" -> {l['product'].get('name') or l['product'].get('asin')} x{l['product'].get('quantity', 1)}" if l.get("product") else ""))
            print("site cart:", json.dumps(r.get("cart"))[:800])
        else:
            sys.exit("cart status|login|refresh|logout|candidates|choose|fill|show|diff|set")
    elif a.cmd == "order":
        print("Tier 1: checkout is Hal's or Dani's, in the Amazon app on Dani's account. `mealplan cart fill` puts the groceries in the cart; then tell them.")
    else:
        ap.print_help()


if __name__ == "__main__":
    main()
