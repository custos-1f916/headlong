+# ---------------------------------------------------------------------------
+# Self-termination guard (SHELLM_GUARD=0 disables)
+# ---------------------------------------------------------------------------
+# A model debugging a stuck sub-run has twice mistaken its own shellm for the
+# child and killed its own run (rc=143), the way Audel stopped its own service.
+# Each executed block therefore starts with shell functions that shadow kill,
+# pkill, killall, systemctl and thinkers, refusing a target that is this run,
+# any ancestor of it (the step, the dispatcher, the service), its process
+# group, or the thinkers runtime. A child the block started is still an
+# ordinary `kill <pid>`. This guards accidents, not adversaries: `command
+# kill` bypasses it, and the refusal says so in the block's own output.
+_shellm_protected_pids() {
+    local p=$$ chain="" n=0
+    while [[ -n "$p" && "$p" != 0 && "$p" != 1 && $n -lt 12 ]]; do
+        chain="$chain $p"
+        p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
+        n=$((n + 1))
+    done
+    printf '%s' "${chain# }"
+}
+_shellm_guard_preamble() {
+    [[ "${SHELLM_GUARD:-1}" == "0" ]] && return 0
+    cat <<'GUARD'
+__shellm_guard_refuse() { printf '%s\n' "[shellm guard] refused: $* — this would signal your own run, its dispatcher, or the thinkers service. A child process you started is a normal 'kill <pid>'; find it with pgrep -P \$\$ or the pid you recorded." >&2; return 125; }
+__shellm_protected() { case " ${SHELLM_PROTECTED_PIDS:-} " in *" $1 "*) return 0;; esac; [[ -n "${SHELLM_PROTECTED_PGID:-}" && "$1" == "$SHELLM_PROTECTED_PGID" ]]; }
+kill() {
+  local a t
+  for a in "$@"; do
+    case "$a" in
+      -[0-9]*) t="${a#-}"; if [[ "$t" =~ ^[0-9]+$ ]] && __shellm_protected "$t"; then __shellm_guard_refuse "kill $*"; return $?; fi ;;
+      0) __shellm_guard_refuse "kill $*"; return $? ;;
+      [0-9]*) if __shellm_protected "$a"; then __shellm_guard_refuse "kill $*"; return $?; fi ;;
+    esac
+  done
+  command kill "$@"
