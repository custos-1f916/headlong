+++ b/tests/test_identity_strict_activation.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+# Fresh identities omit optional metadata. Strict callers must still be able
+# to write into the selected identity, without contaminating another one.
+set -euo pipefail
+HERE="$(cd "$(dirname "$0")" && pwd)"
+export PATH="$(dirname "$HERE")/bin:$(dirname "$HERE")/tools:$PATH"
+unset IDENTITY_NAME IDENTITY_DIR MEM_DIR TRAJ_DIR TRAJ_ID ROOT_TRAJ_ID
+WORK=$(mktemp -d)
+trap 'rm -rf "$WORK"' EXIT
+(cd "$WORK" && identity new alpha >/dev/null && identity new beta >/dev/null)
+ALPHA="$WORK/.identities/alpha"
+BETA="$WORK/.identities/beta"
+name=$(bash -euo pipefail -c 'source "$1"; mem add "Keep this goal private to alpha" --type goal' _ "$ALPHA/activate")
+MEM_DIR="$ALPHA/memories" mem show "$name" | grep -q 'Keep this goal private to alpha'
+if MEM_DIR="$BETA/memories" mem show "$name" >/dev/null 2>&1; then
+    echo 'FAIL: activation wrote into the wrong identity' >&2
+    exit 1
+fi
+printf '%s\n' 'PASS: strict activation permits real memory work only in the selected identity'
