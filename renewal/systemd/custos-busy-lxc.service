[Unit]
Description=Custos Johan socket busy observation (LXC 131 custos-brain)
Wants=network-online.target
After=network-online.target

[Service]
# Runs in an unprivileged LXC (131 custos-brain): mount-namespace hardening (ProtectSystem, PrivateTmp,
# ReadOnlyPaths…) fails there with 226/NAMESPACE, so only the seccomp/prctl-level limits are kept.
Type=simple
User=root
Group=root
RuntimeDirectory=custos-gateway
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 /opt/custos-brain/custos_busy.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=64
TasksMax=8
MemoryMax=96M

[Install]
WantedBy=multi-user.target
