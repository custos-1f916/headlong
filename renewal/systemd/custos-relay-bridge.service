[Unit]
Description=Custos persistent Remote Pi phone bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/custos-headlong.env
WorkingDirectory=/opt/custos/current/renewal
ExecStart=/usr/bin/node /opt/custos/current/renewal/relay-bridge.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
