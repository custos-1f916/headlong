[Unit]
Description=Custos persistent Headlong mind (root in its own LXC)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=forking
User=root
EnvironmentFile=/etc/custos-headlong.env
WorkingDirectory=/opt/custos/work
PIDFile=/root/.headlong/app/.identities/custos/run/dispatcher.pid
ExecCondition=/usr/bin/python3 /opt/custos/current/renewal/mind_enabled.py
ExecStart=/bin/bash -c 'source /root/.headlong/app/.identities/custos/activate >/dev/null 2>&1; exec thinkers start monolith responder social'
# Messages that arrived while the mind was stopped (a maintenance window) are
# handed back to the responder once the dispatcher is up, oldest first.
ExecStartPost=/bin/bash -c 'sleep 8; source /root/.headlong/app/.identities/custos/activate >/dev/null 2>&1; custos-memory replay-unanswered --older-than 60 --limit 5 || true'
ExecStop=/bin/bash -c 'source /root/.headlong/app/.identities/custos/activate >/dev/null 2>&1; exec thinkers stop --self --force'
Restart=on-failure
RestartSec=30
TimeoutStartSec=30
TimeoutStopSec=20
KillMode=control-group
# Leave the guest control plane headroom; an oversized tool process must fail,
# not stall the entire 6GiB LXC. The dispatcher may continue after a child OOM.
MemoryMax=4G
MemorySwapMax=512M
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
