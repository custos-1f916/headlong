[Unit]
Description=Custos inference gateway with brain policy (LXC 131 custos-brain; johan or a cloud tier)
Wants=network-online.target custos-busy.service
After=network-online.target custos-busy.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# Runs in an unprivileged LXC (131 custos-brain): mount-namespace hardening (ProtectSystem, PrivateTmp,
# ReadOnlyPaths…) fails there with 226/NAMESPACE, so only the seccomp/prctl-level limits are kept.
Type=simple
User=custos-brain
Group=custos-brain
StateDirectory=custos-brain
StateDirectoryMode=0700
# The gateway keeps its fixed policy; the brain policy adds the cloud tier and the sticky revert.
ExecStartPre=/usr/bin/test -r /var/lib/custos-brain/codex-auth.json
ExecStart=/usr/bin/python3 /opt/custos-brain/custos_gateway.py --policy /etc/custos-brain/gateway-policy.json --brain /etc/custos-brain/brain.json --state-dir /var/lib/custos-brain
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Egress: LXC 122 (client), johan, and the cloud tier (chatgpt.com / auth.openai.com / ntfy.sh);
# the container's own nftables narrows the inbound side to 192.168.86.52:18080.
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=256
TasksMax=32
MemoryMax=256M

[Install]
WantedBy=multi-user.target
